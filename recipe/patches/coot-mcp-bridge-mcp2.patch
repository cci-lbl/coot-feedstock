Accept mcp 2.x as well as 1.x in the MCP socket bridge.

mcp 2.0 renamed mcp.server.fastmcp.FastMCP to
mcp.server.mcpserver.MCPServer and left a stub at the old path that
raises ImportError. The bridge only uses the constructor, tool(),
resource(), and run(), which are the same on both classes, so try the
new import first and fall back to the old one.

--- a/coot/mcp/coot_mcp_socket_bridge.py
+++ b/coot/mcp/coot_mcp_socket_bridge.py
@@ -4,14 +4,19 @@
 import os
 import itertools
 from pathlib import Path
-from mcp.server.fastmcp import FastMCP
+# mcp 2.x renamed FastMCP to MCPServer; mcp 1.2+ ships FastMCP. The parts
+# used here (name, tool(), resource(), run()) are the same in both.
+try:
+    from mcp.server.mcpserver import MCPServer as _CootMCPServer
+except ImportError:
+    from mcp.server.fastmcp import FastMCP as _CootMCPServer
 
 # CONFIGURATION
 COOT_HOST = "localhost"
 COOT_PORT = 9090
 
 # Initialize MCP Server
-mcp    = FastMCP("Coot Socket Bridge")
+mcp    = _CootMCPServer("Coot Socket Bridge")
 
 _request_id = itertools.count(0)
 
