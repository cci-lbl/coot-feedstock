Use _fullpath() on every Windows toolchain, not only MSVC.

MinGW-w64 has no realpath(), so set_realpath_for_coot_executable()
failed to compile there.

--- a/coot/utils/coot-utils.cc	2026-09-30 20:21:38
+++ b/coot/utils/coot-utils.cc	2026-10-26 15:37:52
@@ -71,7 +71,8 @@
 void coot::set_realpath_for_coot_executable(const std::string &argv0) {
 
    // 20240902-PE patch from Charles - compiling on Windows
-#ifdef _MSC_VER
+#ifdef _WIN32
+   // MinGW has no realpath(); _fullpath() is the Windows equivalent.
    char *exec_path = _fullpath(NULL, argv0.c_str(), MAX_PATH);
 #else
    char *exec_path = realpath(argv0.c_str(), NULL);
